{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "unpitch": {
      "type": "streamable-http",
      "url": "https://api.unpitch.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://api.unpitch.ai/mcp",
            "baseScopes": ["email", "offline_access"],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
